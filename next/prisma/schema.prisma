model JobRun {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  jobName        String    @map("job_name") @db.VarChar(80)
  runId          String    @map("run_id") @db.VarChar(64)
  leaseOwner     String    @map("lease_owner") @db.VarChar(80)
  status         String    @map("status") @db.VarChar(20)
  startedAt      DateTime  @default(now()) @map("started_at")
  leaseExpiresAt DateTime  @map("lease_expires_at")
  completedAt    DateTime? @map("completed_at")
  durationMs     BigInt?   @map("duration_ms") @db.UnsignedBigInt
  errorMessage   String?   @map("error_message") @db.VarChar(2000)

  @@unique([jobName], map: "uq_job_runs_name")
  @@index([status, leaseExpiresAt], map: "idx_job_runs_lease")
  @@index([startedAt], map: "idx_job_runs_started")
  @@map("job_runs")
}
