# WeatherAPI.com — https://www.weatherapi.com/
WEATHERAPI_KEY=your_api_key_here

# MySQL — runtime application connection
DATABASE_URL="mysql://database_user:database_password@127.0.0.1:3306/keshavarz"

# MySQL — direct connection used only by Prisma CLI and migrations
DIRECT_DATABASE_URL="mysql://database_user:database_password@127.0.0.1:3306/keshavarz"

# MySQL — disposable database used only for migration drift checks
SHADOW_DATABASE_URL="mysql://database_user:database_password@127.0.0.1:3306/keshavarz_shadow"

# API security
# Runtime environment: local | development | test | staging | production
# Anything other than "production" uses the fixed OTP code 123456 and skips
# real SMS delivery (codes are printed to the server console instead)
APP_ENV="local"
APP_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3000"
TOKEN_HASH_SECRET="replace-with-at-least-32-random-characters"
OTP_HASH_PEPPER="replace-with-at-least-32-random-characters"

# Optional secret rotation: during a rollover keep the previous secret/pepper
# set so existing session hashes / OTP codes remain verifiable, then remove it
# after the window closes. New values are always signed with the primary.
TOKEN_HASH_SECRET_PREVIOUS=""
OTP_HASH_PEPPER_PREVIOUS=""

# Optional bootstrap admin created by `pnpm db:seed`
ADMIN_SEED_PHONE="09120000000"
ADMIN_SEED_PASSWORD="ChangeMeAdmin!99"
ADMIN_SEED_NAME="مدیر سیستم"

# Production rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Async SMS queue gateway — leave empty in development to print OTP codes
# to the dev server console instead of delivering real SMS
SMS_QUEUE_URL=""
SMS_QUEUE_TOKEN=""

# Object storage gateway
OBJECT_STORAGE_GATEWAY_URL=""
OBJECT_STORAGE_GATEWAY_TOKEN=""
